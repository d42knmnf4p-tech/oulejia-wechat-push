# 复制本文件为仓库根目录的 .env.local（.gitignore 已忽略，不会进仓库）
# 云函数运行所需的环境变量，由 tcb-func/deploy.py 读取后注入 cloudbaserc.json，
# 部署结束即删除临时配置，敏感值不落盘进仓库。

# 必填：企业微信群机器人 webhook
WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key

# 可选：回写日历"已发"状态用。需要有该仓库 repo 写权限的 token。
# 不填也能正常发消息，但日历上永远显示"未发"。
GITHUB_TOKEN=github_pat_xxx

# 可选：仓库，默认 d42knmnf4p-tech/oulejia-wechat-push
GITHUB_REPO=d42knmnf4p-tech/oulejia-wechat-push

# 可选：分支，留空 = 仓库默认分支
GITHUB_BRANCH=
